generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  password             String
  name                 String
  role                 Role                  @default(USER)
  address              String?
  phone                String?
  profilePicture       String?
  avatar               String?
  theme                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isVerified           Boolean               @default(false)
  otp                  Int?
  otpExpiresAt         DateTime?
  provider             String?
  providerId           String?
  cartItems            CartItem[]
  clothingVotes        ClothingVote[]
  fitnessPurchases     FitnessPurchase[]
  fitnessSubscriptions FitnessSubscription[]
  fitnessWaitlist      FitnessWaitlist[]
  messages             Message[]
  notifications        Notification[]
  orders               Order[]
  payments             Payment[]
  requests             Request[]
  wishlist             Wishlist[]
  feedbacks            Feedback[]
}

model Product {
  id           Int                  @id @default(autoincrement())
  name         String
  description  String
  price        Float
  categoryId   Int
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  category     Category             @relation(fields: [categoryId], references: [id])
  sizes        ProductSize[]
  colors       Color[]
  translations ProductTranslation[]
  wishlist     Wishlist[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
}

model ProductTranslation {
  id          Int      @id @default(autoincrement())
  productId   Int
  language    String
  name        String
  description String
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId, language])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Size {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  products  ProductSize[]
}

model ProductSize {
  id        Int     @id @default(autoincrement())
  productId Int
  sizeId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size    @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([productId, sizeId])
}

model Color {
  id         Int     @id @default(autoincrement())
  colorName  String
  imageUrl   String
  hoverImage String?
  position   Int     @default(0)
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Wishlist {
  id            Int     @id @default(autoincrement())
  userId        Int
  productId     Int
  selectedSize  String?
  selectedColor String?
  quantity      Int     @default(1)
  product       Product @relation(fields: [productId], references: [id])
  user          User    @relation(fields: [userId], references: [id])

  @@unique([userId, productId, selectedSize, selectedColor])
  @@index([productId])
}

model CartItem {
  id            Int     @id @default(autoincrement())
  userId        Int
  productId     Int
  quantity      Int
  selectedSize  String?
  selectedColor String?
  name          String  @default("")
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, selectedSize, selectedColor])
  @@index([productId])
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  payment    Payment?    @relation("OrderPayment")

  @@index([userId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  amount    Float
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation("OrderPayment", fields: [orderId], references: [id])

  @@index([orderId])
}

model ClothingVote {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model FitnessProgram {
  id                Int      @id @default(autoincrement())
  title             String
  description       String
  image             String?
  video             String?
  pdfUrl            String?
  price             Float
  duration          Int
  difficulty        String?
  equipment         String?
  goals             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  instructions      String?
  explanationVideo  String?
  programText       String?
  purchases         FitnessPurchase[]
  subscriptions     FitnessSubscription[]
  waitlist          FitnessWaitlist[]
}

model FitnessPurchase {
  id        Int            @id @default(autoincrement())
  userId    Int
  programId Int
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   FitnessProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
}

model FitnessSubscription {
  id        Int            @id @default(autoincrement())
  userId    Int
  programId Int
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   FitnessProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
}

model FitnessWaitlist {
  id        Int            @id @default(autoincrement())
  userId    Int
  programId Int
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   FitnessProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
}

model Message {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String
  createdAt DateTime @default(now())
  user      User     @relation("UserMessages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Request {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}


